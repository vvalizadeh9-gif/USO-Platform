# UEP-23 -- the four values that differ per site. The ONLY place they live.
#
# kustomization.yaml reads this file and copies each value into every manifest
# that needs it. Change a value here, re-render (or re-download the
# uep-k8s-<sha>.yaml from GitHub after the next build), and it changes
# everywhere. No secrets here -- this file is committed.
#
# Placeholders start with CHANGE_ME_. README.md beside this file says where to
# get each value.

# Where the cluster pulls images from (no trailing slash). The GitHub workflow
# pushes to ghcr.io/vvalizadeh9-gif by default; IT's registry if the cluster
# cannot reach the internet.
REGISTRY=CHANGE_ME_REGISTRY

# The address users type, without https:// (DNS name for the Ingress).
HOSTNAME=CHANGE_ME_HOSTNAME

# The Ingress controller's class name (IT knows it; Rancher shows it on other
# teams' Ingresses).
INGRESS_CLASS=CHANGE_ME_INGRESS_CLASS

# The database server as seen from inside the cluster: full DNS name or IP.
# IT gave "t3vl1177", which may only resolve on some networks.
DB_HOST=CHANGE_ME_DB_HOST
