# Copy to .env and adjust for your VPS. NEVER commit the real .env.
#
# The backend refuses to start if JWT_SECRET_KEY or FIRST_ADMIN_PASSWORD is left
# at the example value below, or if CORS_ORIGINS is "*". That is deliberate: if
# .env goes missing or fails to mount, every setting falls back to a value
# published in this repository, and anyone could sign their own admin token.
# Failing loudly at startup turns a silent compromise into an obvious error.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# Leave unset (or anything other than "development") on a real server.
# Set APP_ENV=development only on a local machine, where it allows the
# insecure example values below.
#APP_ENV=development

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The password here must match POSTGRES_PASSWORD below.
DATABASE_URL=postgresql+psycopg://uep:CHANGE_THIS_DATABASE_PASSWORD@db:5432/uep

POSTGRES_USER=uep
POSTGRES_PASSWORD=CHANGE_THIS_DATABASE_PASSWORD
POSTGRES_DB=uep

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Must be at least 32 characters. Generate a fresh one with:
#     openssl rand -hex 32
# Changing it signs everyone out immediately; it does not affect stored data.
JWT_SECRET_KEY=change_this_to_a_long_random_string

ACCESS_TOKEN_EXPIRE_MINUTES=480

# Optional. Signs the login captcha. Left empty, one is derived from
# JWT_SECRET_KEY -- a separate value, so the key that mints admin sessions is
# not also on the token handed to every anonymous visitor. Set it explicitly
# only if you want the two rotated independently.
#CAPTCHA_SECRET_KEY=

# Login throttling. Counts only failed attempts; a success clears the count, so
# people who know their password never meet these limits.
LOGIN_MAX_ATTEMPTS_PER_USERNAME=5
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_ATTEMPT_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=900

# ---------------------------------------------------------------------------
# Which addresses the browser may call the API from
# ---------------------------------------------------------------------------
# Must name real origins -- "*" is rejected, because combined with credentials
# it makes the server accept requests from any site a logged-in user visits.
# Comma-separated if there is more than one. Include the scheme and the port if
# it is not the default. After switching to HTTPS, change http:// to https://.
CORS_ORIGINS=http://uep.example.com

# ---------------------------------------------------------------------------
# First admin, created once on first start
# ---------------------------------------------------------------------------
# Changing FIRST_ADMIN_PASSWORD later does NOT change the existing admin's
# password -- the user is only created if it does not already exist. To change
# it afterwards, use the Admin screen, or see RUNBOOK.md.
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD
FIRST_ADMIN_FULLNAME=System Administrator

# ---------------------------------------------------------------------------
# HTTPS
# ---------------------------------------------------------------------------
# Left false, the site is served over plain HTTP -- which means passwords and
# session tokens cross the network as readable text. Set this to true once a
# certificate is mounted; see TLS-SETUP.md, which is written for someone who
# has not done it before.
#
# If this is true and the certificate is missing, the frontend container
# refuses to start rather than quietly serving HTTP. Fix the certificate, or
# set this back to false.
UEP_ENABLE_TLS=false

# The address staff type into the browser. Required when TLS is on.
#UEP_SERVER_NAME=uep.example.com

# Only needed if the certificate is not directly inside the mounted directory.
# certbot nests its files under live/<domain>/.
#UEP_CERT_DIR=/etc/nginx/certs/live/uep.example.com

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=20

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# LOG_LEVEL: DEBUG, INFO, WARNING or ERROR. INFO is right for normal running.
# LOG_FORMAT: "json" for a log collector, "text" if you read `docker logs` by eye.
LOG_LEVEL=INFO
LOG_FORMAT=json
